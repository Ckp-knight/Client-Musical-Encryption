<Window x:Class="Musical_Encryption_Project.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Musical_Encryption_Project"
        mc:Ignorable="d"
        Title="Musical Encryption"
        Height="660" Width="820"
        FontFamily="Segoe UI">

    <Window.Resources>

        <!-- Color palette -->
        <SolidColorBrush x:Key="CardBackground" Color="#D9D9D9" />
        <SolidColorBrush x:Key="FieldBackground" Color="#F2F2F2" />
        <SolidColorBrush x:Key="TextColor" Color="Black" />
        <SolidColorBrush x:Key="FieldBorder" Color="#9E9E9E" />
        <SolidColorBrush x:Key="AccentGreen" Color="#2E7D32" />
        <SolidColorBrush x:Key="PlaceholderColor" Color="#8A8A8A" />
        <SolidColorBrush x:Key="RuleRed" Color="#C62828" />

        <!-- Base field label -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource TextColor}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <!-- Styled text box -->
        <Style x:Key="FieldTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource TextColor}" />
            <Setter Property="Background" Value="{StaticResource FieldBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource FieldBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <Grid>
                                <!-- Placeholder: set via the TextBox's Tag property. Shares the exact
                                     same Margin as PART_ContentHost below, so it lines up with the
                                     caret pixel-for-pixel instead of relying on a separately-guessed offset. -->
                                <TextBlock x:Name="placeholder"
                                           Text="{TemplateBinding Tag}"
                                           Foreground="{StaticResource PlaceholderColor}"
                                           FontSize="{TemplateBinding FontSize}"
                                           Margin="{TemplateBinding Padding}"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Focusable="False"
                                           Visibility="Collapsed" />
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#616161" />
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource AccentGreen}" />
                            </Trigger>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="placeholder" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Styled password box (same look as the text box) -->
        <Style x:Key="FieldPasswordBox" TargetType="PasswordBox">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource TextColor}" />
            <Setter Property="Background" Value="{StaticResource FieldBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource FieldBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#616161" />
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource AccentGreen}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary green button -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="40" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource AccentGreen}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#388E3C" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1B5E20" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#9E9E9E" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small text button -->
        <Style x:Key="TextButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextColor}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="4,2">
                            <TextBlock x:Name="t"
                                       Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}"
                                       HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="t" Property="TextDecorations" Value="Underline" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Text button as RadioButton, used to switch screens (XAML only, no code-behind) -->
        <Style x:Key="TextRadioButton" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextColor}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="Transparent" Padding="4,2">
                            <TextBlock x:Name="t"
                                       Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}"
                                       HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="t" Property="TextDecorations" Value="Underline" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Language switch button (top-right). Unchecked = English (default), Checked = Hebrew -->
        <Style x:Key="LangButton" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource TextColor}" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd"
                                Background="{StaticResource FieldBackground}"
                                BorderBrush="{StaticResource FieldBorder}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#616161" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#C8C8C8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Logo button, top-left. Click fills admin test credentials on the login screen. -->
        <Style x:Key="LogoButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <Image x:Name="img"
                                   Source="musical encryption logo.png"
                                   Stretch="Uniform"
                                   RenderTransformOrigin="0.5,0.5">
                                <Image.RenderTransform>
                                    <ScaleTransform x:Name="imgScale" ScaleX="1" ScaleY="1" />
                                </Image.RenderTransform>
                            </Image>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="imgScale" Storyboard.TargetProperty="ScaleX" To="1.12" Duration="0:0:0.15" />
                                            <DoubleAnimation Storyboard.TargetName="imgScale" Storyboard.TargetProperty="ScaleY" To="1.12" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="imgScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.15" />
                                            <DoubleAnimation Storyboard.TargetName="imgScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="imgScale" Storyboard.TargetProperty="ScaleX" To="0.92" Duration="0:0:0.08" />
                                            <DoubleAnimation Storyboard.TargetName="imgScale" Storyboard.TargetProperty="ScaleY" To="0.92" Duration="0:0:0.08" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="imgScale" Storyboard.TargetProperty="ScaleX" To="1.12" Duration="0:0:0.08" />
                                            <DoubleAnimation Storyboard.TargetName="imgScale" Storyboard.TargetProperty="ScaleY" To="1.12" Duration="0:0:0.08" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Eye button that shows/hides a password field. Unchecked = hidden, Checked = revealed. -->
        <Style x:Key="EyeToggleButton" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource PlaceholderColor}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent">
                            <Grid>
                                <TextBlock x:Name="eyeShow"
                                           FontFamily="Segoe MDL2 Assets"
                                           Text="&#xE7B3;"
                                           FontSize="16"
                                           Foreground="{TemplateBinding Foreground}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                                <TextBlock x:Name="eyeHide"
                                           FontFamily="Segoe MDL2 Assets"
                                           Text="&#xED1A;"
                                           FontSize="16"
                                           Foreground="{TemplateBinding Foreground}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="eyeShow" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="eyeHide" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="eyeShow" Property="Foreground" Value="#616161" />
                                <Setter TargetName="eyeHide" Property="Foreground" Value="#616161" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Localized text styles: default English, switch to Hebrew when LangToggle is checked ===== -->

        <Style x:Key="UsernameLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
            <Setter Property="Text" Value="Username" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked, ElementName=LangToggle}" Value="True">
                    <Setter Property="Text" Value="שם משתמש" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PasswordLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
            <Setter Property="Text" Value="Password" />
            <Setter Property="Margin" Value="0,14,0,4" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked, ElementName=LangToggle}" Value="True">
                    <Setter Property="Text" Value="סיסמה" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ConfirmPasswordLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
            <Setter Property="Text" Value="Confirm Password" />
            <Setter Property="Margin" Value="0,14,0,4" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked, ElementName=LangToggle}" Value="True">
                    <Setter Property="Text" Value="אימות סיסמה" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CreateUserTitleStyle" TargetType="TextBlock">
            <Setter Property="Text" Value="Create Account" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource TextColor}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,0,20" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked, ElementName=LangToggle}" Value="True">
                    <Setter Property="Text" Value="יצירת משתמש" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="VersionTextStyle" TargetType="TextBlock">
            <Setter Property="Text" Value="Version 1.0.0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextColor}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked, ElementName=LangToggle}" Value="True">
                    <Setter Property="Text" Value="גרסה 1.0.0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LoginButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Content" Value="Login" />
            <Setter Property="Margin" Value="0,20,0,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked, ElementName=LangToggle}" Value="True">
                    <Setter Property="Content" Value="היכנס" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CreateButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Content" Value="Create Account" />
            <Setter Property="Margin" Value="0,20,0,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked, ElementName=LangToggle}" Value="True">
                    <Setter Property="Content" Value="צור משתמש" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="OtherWayButtonStyle" TargetType="Button" BasedOn="{StaticResource TextButton}">
            <Setter Property="Content" Value="Sign in another way" />
            <Setter Property="Margin" Value="0,8,0,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked, ElementName=LangToggle}" Value="True">
                    <Setter Property="Content" Value="היכנס בדרך אחרת" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ExitButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Content" Value="Exit" />
            <Setter Property="Width" Value="110" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked, ElementName=LangToggle}" Value="True">
                    <Setter Property="Content" Value="צא" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NavToCreateUserStyle" TargetType="RadioButton" BasedOn="{StaticResource TextRadioButton}">
            <Setter Property="Content" Value="Create account" />
            <Setter Property="Margin" Value="0,12,0,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked, ElementName=LangToggle}" Value="True">
                    <Setter Property="Content" Value="צור משתמש" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NavToLoginStyle" TargetType="RadioButton" BasedOn="{StaticResource TextRadioButton}">
            <Setter Property="Content" Value="Back to login" />
            <Setter Property="Margin" Value="0,12,0,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked, ElementName=LangToggle}" Value="True">
                    <Setter Property="Content" Value="חזרה להתחברות" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ===== Create-account rule texts (bilingual). Colour is set from code-behind. ===== -->

        <Style x:Key="RuleLenTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Text" Value="3&#x2013;20 characters" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked, ElementName=LangToggle}" Value="True">
                    <Setter Property="Text" Value="&#x200F;3&#x2013;20 &#x05EA;&#x05D5;&#x05D5;&#x05D9;&#x05DD;" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RuleCharsTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Text" Value="English letters and digits only" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked, ElementName=LangToggle}" Value="True">
                    <Setter Property="Text" Value="&#x200F;&#x05D0;&#x05D5;&#x05EA;&#x05D9;&#x05D5;&#x05EA; &#x05D5;&#x05E1;&#x05E4;&#x05E8;&#x05D5;&#x05EA; &#x05D1;&#x05D0;&#x05E0;&#x05D2;&#x05DC;&#x05D9;&#x05EA; &#x05D1;&#x05DC;&#x05D1;&#x05D3;" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RuleStartTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Text" Value="Starts with a letter" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked, ElementName=LangToggle}" Value="True">
                    <Setter Property="Text" Value="&#x200F;&#x05DE;&#x05EA;&#x05D7;&#x05D9;&#x05DC; &#x05D1;&#x05D0;&#x05D5;&#x05EA;" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RulePwLenTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Text" Value="At least 8 characters" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked, ElementName=LangToggle}" Value="True">
                    <Setter Property="Text" Value="&#x200F;&#x05DC;&#x05E4;&#x05D7;&#x05D5;&#x05EA; 8 &#x05EA;&#x05D5;&#x05D5;&#x05D9;&#x05DD;" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RulePwUpperTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Text" Value="Contains an uppercase letter" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked, ElementName=LangToggle}" Value="True">
                    <Setter Property="Text" Value="&#x200F;&#x05DE;&#x05DB;&#x05D9;&#x05DC;&#x05D4; &#x05D0;&#x05D5;&#x05EA; &#x05D2;&#x05D3;&#x05D5;&#x05DC;&#x05D4;" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RulePwLowerTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Text" Value="Contains a lowercase letter" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked, ElementName=LangToggle}" Value="True">
                    <Setter Property="Text" Value="&#x200F;&#x05DE;&#x05DB;&#x05D9;&#x05DC;&#x05D4; &#x05D0;&#x05D5;&#x05EA; &#x05E7;&#x05D8;&#x05E0;&#x05D4;" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RulePwDigitTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Text" Value="Contains a digit" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked, ElementName=LangToggle}" Value="True">
                    <Setter Property="Text" Value="&#x200F;&#x05DE;&#x05DB;&#x05D9;&#x05DC;&#x05D4; &#x05E1;&#x05E4;&#x05E8;&#x05D4;" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RuleMatchTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Text" Value="Passwords match" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked, ElementName=LangToggle}" Value="True">
                    <Setter Property="Text" Value="&#x200F;&#x05D4;&#x05E1;&#x05D9;&#x05E1;&#x05DE;&#x05D0;&#x05D5;&#x05EA; &#x05EA;&#x05D5;&#x05D0;&#x05DE;&#x05D5;&#x05EA;" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Screen shown only while NavToCreateUser and NavToApp are both unchecked (login screen) -->
        <Style x:Key="LoginScreenVisibility" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked, ElementName=NavToCreateUser}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsChecked, ElementName=NavToApp}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Screen shown only while NavToCreateUser is checked (create-account screen) -->
        <Style x:Key="CreateUserScreenVisibility" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked, ElementName=NavToCreateUser}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Screen shown only while NavToApp is checked (signed in — the app itself) -->
        <Style x:Key="AppScreenVisibility" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked, ElementName=NavToApp}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <!-- Background: translucent gray (the rest of the app will show through later, like the Minecraft GUI dim) -->
    <Grid Background="#B3808080">

        <!-- Logo, top-left. Click fills admin test credentials for quick sign-in. -->
        <Button x:Name="LogoButton"
                Style="{StaticResource LogoButtonStyle}"
                Width="80"
                Height="80"
                Margin="20"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                ToolTip="Admin quick-fill" />

        <!-- Language switch, top-right -->
        <ToggleButton x:Name="LangToggle"
                      Content="Language"
                      Style="{StaticResource LangButton}"
                      Margin="20"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Top" />

        <!-- Not shown: tracks which screen is active (Screen group), alongside NavToCreateUser/NavToLogin -->
        <RadioButton x:Name="NavToApp" GroupName="Screen" Visibility="Collapsed" />

        <!-- Software version, bottom-left -->
        <TextBlock Style="{StaticResource VersionTextStyle}"
                   Margin="20"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Bottom" />

        <!-- ===================== Login screen ===================== -->
        <StackPanel Style="{StaticResource LoginScreenVisibility}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

            <Border Width="340"
                    Background="{StaticResource CardBackground}"
                    BorderBrush="#8A8A8A"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="26,22">
                <StackPanel>

                    <TextBlock Text="Musical Encryption"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextColor}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,20" />

                    <TextBlock Style="{StaticResource UsernameLabelStyle}" />
                    <Grid>
                        <TextBox x:Name="UsernameTextBox"
                                 Style="{StaticResource FieldTextBox}" />
                    </Grid>

                    <TextBlock Style="{StaticResource PasswordLabelStyle}" />
                    <Grid>
                        <PasswordBox x:Name="PasswordBox"
                                     Style="{StaticResource FieldPasswordBox}"
                                     Padding="6,0,34,0" />
                        <TextBox x:Name="PasswordText"
                                 Style="{StaticResource FieldTextBox}"
                                 Padding="6,0,34,0"
                                 Visibility="Collapsed" />
                        <ToggleButton x:Name="PasswordReveal"
                                      Style="{StaticResource EyeToggleButton}"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      Margin="0,0,4,0" />
                    </Grid>

                    <Button x:Name="LoginButton" Style="{StaticResource LoginButtonStyle}" />

                    <!-- Result of the last login attempt: server response shows up here. -->
                    <TextBlock x:Name="LoginStatusText"
                               TextWrapping="Wrap"
                               FontSize="12"
                               Margin="0,10,0,0"
                               HorizontalAlignment="Center" />

                    <Button Style="{StaticResource OtherWayButtonStyle}" />

                </StackPanel>
            </Border>

            <!-- Go to the create-account screen -->
            <RadioButton x:Name="NavToCreateUser"
                         GroupName="Screen"
                         Style="{StaticResource NavToCreateUserStyle}" />

        </StackPanel>

        <!-- ===================== Create-account screen ===================== -->
        <StackPanel Style="{StaticResource CreateUserScreenVisibility}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

            <Border Width="340"
                    Background="{StaticResource CardBackground}"
                    BorderBrush="#8A8A8A"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="26,22">
                <StackPanel>

                    <TextBlock Style="{StaticResource CreateUserTitleStyle}" />

                    <TextBlock Style="{StaticResource UsernameLabelStyle}" />
                    <Grid>
                        <TextBox x:Name="NewUsernameTextBox"
                                 Style="{StaticResource FieldTextBox}" />
                    </Grid>

                    <!-- Username rules, shown right under the username field. -->
                    <StackPanel Margin="0,8,0,0">
                        <StackPanel x:Name="RuleLen" Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock x:Name="RuleLenIcon" Text="&#x2717;" Width="16" FontWeight="Bold" FontSize="12" />
                            <TextBlock Style="{StaticResource RuleLenTextStyle}" />
                        </StackPanel>
                        <StackPanel x:Name="RuleChars" Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock x:Name="RuleCharsIcon" Text="&#x2717;" Width="16" FontWeight="Bold" FontSize="12" />
                            <TextBlock Style="{StaticResource RuleCharsTextStyle}" />
                        </StackPanel>
                        <StackPanel x:Name="RuleStart" Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock x:Name="RuleStartIcon" Text="&#x2717;" Width="16" FontWeight="Bold" FontSize="12" />
                            <TextBlock Style="{StaticResource RuleStartTextStyle}" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Style="{StaticResource PasswordLabelStyle}" />
                    <Grid>
                        <PasswordBox x:Name="NewPasswordBox"
                                     Style="{StaticResource FieldPasswordBox}"
                                     Padding="6,0,34,0" />
                        <TextBox x:Name="NewPasswordText"
                                 Style="{StaticResource FieldTextBox}"
                                 Padding="6,0,34,0"
                                 Visibility="Collapsed" />
                        <ToggleButton x:Name="NewPasswordReveal"
                                      Style="{StaticResource EyeToggleButton}"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      Margin="0,0,4,0" />
                    </Grid>

                    <TextBlock Style="{StaticResource ConfirmPasswordLabelStyle}" />
                    <Grid>
                        <PasswordBox x:Name="ConfirmPasswordBox"
                                     Style="{StaticResource FieldPasswordBox}"
                                     Padding="6,0,34,0" />
                        <TextBox x:Name="ConfirmPasswordText"
                                 Style="{StaticResource FieldTextBox}"
                                 Padding="6,0,34,0"
                                 Visibility="Collapsed" />
                        <ToggleButton x:Name="ConfirmPasswordReveal"
                                      Style="{StaticResource EyeToggleButton}"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      Margin="0,0,4,0" />
                    </Grid>

                    <!-- Password rules, shown right under the confirm-password field. -->
                    <StackPanel Margin="0,8,0,0">
                        <StackPanel x:Name="RulePwLen" Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock x:Name="RulePwLenIcon" Text="&#x2717;" Width="16" FontWeight="Bold" FontSize="12" />
                            <TextBlock Style="{StaticResource RulePwLenTextStyle}" />
                        </StackPanel>
                        <StackPanel x:Name="RulePwUpper" Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock x:Name="RulePwUpperIcon" Text="&#x2717;" Width="16" FontWeight="Bold" FontSize="12" />
                            <TextBlock Style="{StaticResource RulePwUpperTextStyle}" />
                        </StackPanel>
                        <StackPanel x:Name="RulePwLower" Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock x:Name="RulePwLowerIcon" Text="&#x2717;" Width="16" FontWeight="Bold" FontSize="12" />
                            <TextBlock Style="{StaticResource RulePwLowerTextStyle}" />
                        </StackPanel>
                        <StackPanel x:Name="RulePwDigit" Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock x:Name="RulePwDigitIcon" Text="&#x2717;" Width="16" FontWeight="Bold" FontSize="12" />
                            <TextBlock Style="{StaticResource RulePwDigitTextStyle}" />
                        </StackPanel>
                        <StackPanel x:Name="RuleMatch" Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock x:Name="RuleMatchIcon" Text="&#x2717;" Width="16" FontWeight="Bold" FontSize="12" />
                            <TextBlock Style="{StaticResource RuleMatchTextStyle}" />
                        </StackPanel>
                    </StackPanel>

                    <Button x:Name="CreateAccountButton" Style="{StaticResource CreateButtonStyle}" />

                    <!-- Result of the last "Create Account" attempt: server response shows up here. -->
                    <TextBlock x:Name="CreateAccountStatusText"
                               TextWrapping="Wrap"
                               FontSize="12"
                               Margin="0,10,0,0"
                               HorizontalAlignment="Center" />

                </StackPanel>
            </Border>

            <!-- Back to the login screen -->
            <RadioButton x:Name="NavToLogin"
                         GroupName="Screen"
                         IsChecked="True"
                         Style="{StaticResource NavToLoginStyle}" />

        </StackPanel>

        <!-- ===================== App screen (signed in) ===================== -->
        <!-- Placeholder for now — everything else the app will show goes in here later. -->
        <Grid Style="{StaticResource AppScreenVisibility}">
            <Button x:Name="ExitButton"
                    Style="{StaticResource ExitButtonStyle}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="24" />
        </Grid>

    </Grid>
</Window>
